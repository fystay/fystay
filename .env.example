# On Vercel, the production database values (DATABASE_URL, DIRECT_URL,
# PMS_HOST_SCOPED_DATABASE_URL, NEXT_PUBLIC_SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY) are scoped to Production only; Preview gets the
# separate fystay-preview project's values. A non-production deployment that
# holds production values refuses to build or start (src/lib/databaseIdentity.ts).
DATABASE_URL="postgresql://fystay:fystay@localhost:5432/fystay?schema=public"
# Used only by Prisma Migrate/CLI, not the running app. Locally this can be
# the same value as DATABASE_URL. On Supabase/PgBouncer-fronted setups it
# must be the direct (non-pooled) connection string — see README.
DIRECT_URL="postgresql://fystay:fystay@localhost:5432/fystay?schema=public"

AUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Stripe. Prefer a restricted key (rk_...) over a full secret key (sk_...),
# and use a separate Stripe sandbox per environment (local, CI, preview).
# On Vercel, store these as Sensitive environment variables. With no
# STRIPE_SECRET_KEY, local/preview bookings confirm without payment; a
# production deployment refuses instead (see allowsUnpaidConfirmation).
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint pointing at /api/webhooks/stripe.
# Subscribe it to: checkout.session.completed,
# checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired,
# charge.dispute.created, charge.dispute.updated, charge.dispute.closed,
# identity.verification_session.verified,
# identity.verification_session.requires_input.
STRIPE_WEBHOOK_SECRET=""
# Signing secret of a second endpoint (same URL) with "Listen to events on
# Connected accounts" on, subscribed to account.updated - keeps hosts'
# payout status in sync. Optional: hosts' status also refreshes when they
# return from onboarding.
STRIPE_CONNECT_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Host payouts (Stripe Connect) reuse STRIPE_SECRET_KEY above - no separate
# key. Enable Connect on the same Stripe account (Dashboard > Connect); hosts
# are created as Accounts v2 recipients (see src/lib/stripeConnect.ts). See
# "Host payouts" in README for testing it locally.

# Used for password-reset emails (Resend). If unset, /forgot-password
# returns the reset link directly in dev mode instead of emailing it.
RESEND_API_KEY=""
EMAIL_FROM=""

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Used for host photo uploads (Supabase Storage). NEXT_PUBLIC_SUPABASE_URL is
# not sensitive. SUPABASE_SERVICE_ROLE_KEY is a secret — never expose it to
# the client; it's only read in server-side code (src/lib/storage.ts). If
# unset, the photo upload button shows an error but the rest of the app
# (including pasting photo URLs directly) still works.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Local Guide live data (src/lib/localData/). Weather (Open-Meteo) and
# places (OpenStreetMap/Overpass) are free and keyless - nothing to set
# here for those. Events (Ticketmaster Discovery) need a free API key from
# https://developer.ticketmaster.com - if unset, /api/local/events simply
# returns no events (logged as SKIPPED, not faked) rather than failing.
TICKETMASTER_API_KEY=""
# REQUIRED for every scheduled job in vercel.json to run. Vercel Cron sends
# it as `Authorization: Bearer $CRON_SECRET`, and every /api/cron route
# refuses a request without it (see src/lib/cronAuth.ts). Generate a long
# random string, e.g. `openssl rand -hex 32`, and set it in the Production
# environment.
CRON_SECRET=""
# Optional extra secret for triggering the local-data refresh by hand
# (src/app/api/cron/refresh-local-data/route.ts). CRON_SECRET works too.
LOCAL_DATA_CRON_SECRET=""

# Same idea as LOCAL_DATA_CRON_SECRET above, for the nightly sweep that
# refreshes every listing's imported external calendar
# (/api/cron/sync-ical-imports). Also optional - Vercel Cron works without
# it.
ICAL_SYNC_CRON_SECRET=""

# PMS & Channel Manager integrations (src/lib/pms/). PMS_ENCRYPTION_KEY
# encrypts every connected provider's stored OAuth/API credentials at rest
# (src/lib/pms/crypto.ts) - required before any host can connect a
# provider; generate any long random string and never change it once a
# connection exists (existing ciphertext would no longer decrypt).
# PMS_RECONCILE_CRON_SECRET is optional, same idea as ICAL_SYNC_CRON_SECRET
# above - only needed to trigger the nightly reconcile manually or from
# somewhere other than Vercel Cron.
PMS_ENCRYPTION_KEY=""
PMS_RECONCILE_CRON_SECRET=""
# Optional, additive Postgres Row Level Security for the five PMS tables
# above (src/lib/pms/hostScopedPrisma.ts + the
# 20260914070000_add_pms_row_level_security migration) - a second,
# read/write-restricted DB connection string using the fystay_pms_host_scoped
# role that migration creates, so even a route that forgot its own hostId
# check could never see another host's PMS data. Same host/port/database as
# DATABASE_URL, different user/password:
#   postgresql://fystay_pms_host_scoped:<password>@<host>:<port>/<database>
# The role is created with no usable password by the migration itself -
# never put a real password in a committed migration file. Run this once
# against your real database, then set this var:
#   ALTER ROLE fystay_pms_host_scoped WITH PASSWORD '<a-real-generated-secret>';
# Leave unset and nothing changes - every PMS route keeps working exactly as
# it does today, application-layer ownership checks only.
PMS_HOST_SCOPED_DATABASE_URL=""

# Cloudbeds integration (src/lib/pms/providers/cloudbeds.ts). CLIENT_ID/
# CLIENT_SECRET are the OAuth2 app credentials from Cloudbeds' developer
# portal. WEBHOOK_SECRET verifies inbound webhook deliveries - Cloudbeds'
# exact signing scheme is UNVERIFIED against their current docs (see that
# file's own top-of-file comment), so verifyWebhookSignature fails closed
# regardless of this value until that's confirmed and implemented for
# real; the nightly /api/cron/pms-reconcile sync is unaffected either way.
CLOUDBEDS_CLIENT_ID=""
CLOUDBEDS_CLIENT_SECRET=""
CLOUDBEDS_WEBHOOK_SECRET=""

# Same idea as ICAL_SYNC_CRON_SECRET above, for the daily sweep that sends
# arrival-reminder and review-request emails
# (/api/cron/booking-lifecycle-emails). Also optional - Vercel Cron works
# without it.
BOOKING_LIFECYCLE_CRON_SECRET=""

# Optional two-factor login (src/lib/twoFactor.ts, src/lib/twoFactorCrypto.ts).
# Required before any user can enroll in 2FA - encrypts each account's TOTP
# secret at rest, the same idea as PMS_ENCRYPTION_KEY above but a separate
# key so the two encryption domains never share a blast radius. Generate
# any long random string; changing it after anyone has enrolled would make
# their stored secret undecryptable (they'd need to disable and re-enroll).
TWO_FACTOR_ENCRYPTION_KEY=""

# Trip extras (see docs/trip-extras-roadmap.md) - where the seed script and
# any future admin "add provider" tooling should point EV Exec's real
# booking-request emails, since the seed's own placeholder must never be
# used against production. bookingFormUrl is optional (EV Exec's own
# existing booking page, kept for reference only right now).
EV_EXEC_NOTIFICATION_EMAIL=""
EV_EXEC_BOOKING_FORM_URL=""

# Optional - where a new Stripe chargeback alert email goes
# (src/lib/notificationEmails.ts's sendDisputeAlertEmail). Falls back to
# the public SUPPORT_EMAIL (src/lib/seo.ts) if unset, so this works out of
# the box; set this once there's a dedicated ops/finance inbox that should
# see chargebacks instead.
DISPUTE_ALERT_EMAIL=""

# Required before real launch: the trading entity's legal identity
# (src/lib/companyInfo.ts). UK law requires this to be disclosed on a site
# taking real bookings and payments. All three must be set together - if
# any is missing, the Terms and Privacy pages simply omit the disclosure
# section rather than showing a broken placeholder to guests.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=""
NEXT_PUBLIC_COMPANY_NUMBER=""
NEXT_PUBLIC_COMPANY_ADDRESS=""

# Error monitoring (src/instrumentation.ts, src/instrumentation-client.ts,
# src/lib/apiError.ts). Optional - leave unset and Sentry.init is simply
# never called, so every Sentry.* call in the app becomes a no-op and
# nothing is sent anywhere; unhandled errors still log to the server
# console and still show the user a friendly error page, just without
# being reported anywhere else. Set both DSNs (usually the same value -
# NEXT_PUBLIC_ one for the browser bundle, the other for server/edge) to a
# real Sentry project's DSN to turn this on.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Optional, and only relevant once SENTRY_DSN above is set: lets the
# Sentry Next.js build plugin upload real source maps so stack traces in
# Sentry show your actual source instead of minified output. Generate the
# token from Sentry's own dashboard (Settings > Account > API > Auth
# Tokens). Without it, the build still succeeds - it just skips source
# map upload.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Booking.com Demand API (src/lib/hotelProviders/providers/bookingCom.ts) -
# credentials for FYStay's hotel affiliate marketplace. Both are generated
# from the Booking.com Affiliate Partner Centre, which itself requires
# Managed Affiliate Partner status and a signed contract before it's
# accessible - see that file's own top comment for exactly what's confirmed
# vs. still unconfirmed about this integration. If unset, every method on
# this adapter throws a clear configuration error rather than falling back
# to fake data; the mock provider (src/lib/hotelProviders/providers/mock.ts)
# is what search/detail/deep-link testing actually runs against until real
# credentials exist.
BOOKING_COM_API_KEY=""
BOOKING_COM_AFFILIATE_ID=""
# Defaults to Booking.com's own sandbox host (demandapi-sandbox.booking.com)
# when unset - only ever set this to the production host once you've
# specifically decided to go live, never as a default. Booking.com's
# sandbox uses the exact same credentials as production, so this is the
# only thing that changes between the two.
BOOKING_COM_API_BASE_URL=""

# Shared secret POST/GET /api/admin/seed-demo-data requires (as ?secret= or
# an x-seed-secret header) before it will populate the demo host/guest/
# listings/reviews/trip-extras dataset. Meant as a one-off way to seed a
# freshly-provisioned environment nobody has a direct database connection
# to - unset means the route always 501s, never falls open. Generate any
# random string, set it, trigger the route once, then you can safely
# remove this var again (or leave it - every write the route makes is
# idempotent). On a production deployment (VERCEL_ENV=production) the route
# refuses with 403 regardless - see ALLOW_PRODUCTION_SEED below.
SEED_ADMIN_SECRET=""

# Demo seeding (prisma/seed.ts and /api/admin/seed-demo-data) creates
# published test accounts and marks the mock hotel provider ACTIVE, so both
# refuse to run when VERCEL_ENV=production. Set this to exactly "true" only
# if you deliberately mean to seed demo data into a production database.
# Leave empty everywhere else.
ALLOW_PRODUCTION_SEED=""

# Optional Google sign-in (src/lib/authProviders.ts). The Google provider is
# only registered with NextAuth when both are set - leave both unset and
# credentials/email sign-in keeps working exactly as it does today, no error.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Same idea as ICAL_SYNC_CRON_SECRET above, for the daily sweep that expires
# unanswered Request-to-Book requests (/api/cron/expire-booking-requests).
# Optional - Vercel Cron works without it.
BOOKING_REQUEST_CRON_SECRET=""

# Same idea as ICAL_SYNC_CRON_SECRET above, for the sweep that auto-releases
# uncaptured security deposit holds once their window passes
# (/api/cron/security-deposits). Optional - Vercel Cron works without it.
SECURITY_DEPOSIT_CRON_SECRET=""

# Optional phone verification at signup (src/lib/phoneVerification.ts), via
# Twilio Verify. isPhoneVerificationConfigured() checks all three are set
# before offering it; if any is missing, phone verification is simply never
# offered - no error, no fallback fake verification.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Same idea as CLOUDBEDS_WEBHOOK_SECRET above, for the SiteMinder/
# SuperControl channel-manager stub adapters (src/lib/pms/providers/
# siteminder.ts, supercontrol.ts) - currently inert either way, since both
# adapters declare supportsWebhooks: false until real API access exists.
SITEMINDER_WEBHOOK_SECRET=""
SUPERCONTROL_WEBHOOK_SECRET=""

# Hotel affiliate provider resilience/caching (src/lib/hotelProviders/
# config.ts, resilience.ts, cache.ts; docs/hotel-provider-integration-
# runbook.md). All optional - unset or empty uses the default shown. Any
# other value must be a positive whole number within the stated range, or
# every hotel provider call fails closed (the detail is logged server-side;
# guests see the normal "unavailable" state).
# Timeout for a single attempt, in ms (100-60000). Always further capped by
# whatever remains of the total budget below.
HOTEL_PROVIDER_TIMEOUT_MS="4000"
# Total attempts per provider call, including the first (1-10). Only
# retryable failures use another attempt; a timeout counts as retryable.
HOTEL_PROVIDER_MAX_ATTEMPTS="3"
# Hard ceiling for one provider call across every attempt and backoff, in ms
# (100-120000, and at least HOTEL_PROVIDER_TIMEOUT_MS). With the defaults the
# worst case is ~10s: 4000ms, 200ms backoff, 4000ms, 400ms backoff, then a
# final attempt capped at the ~1400ms left - never 3 x 4000ms.
HOTEL_PROVIDER_TOTAL_BUDGET_MS="10000"
# How long a cached hotel search result is served, in ms (1000-86400000).
HOTEL_SEARCH_CACHE_TTL_MS="300000"
# How long a cached availability (price/room) result is served, in ms
# (1000-86400000) - kept short since this data is price/inventory-sensitive.
HOTEL_AVAILABILITY_CACHE_TTL_MS="60000"
