// Prisma schema for Fystay — an Airbnb-style booking marketplace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  GUEST
  HOST
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  // Some, but not all, of what was paid has been returned - e.g. a
  // cancellation under a policy that refunds less than 100%.
  PARTIALLY_REFUNDED
  REFUNDED
}

// A host's refund rules for guest-initiated cancellations. Each kind maps to
// a fixed set of day-before-check-in cutoffs and refund percentages (see
// src/lib/cancellationPolicy.ts) except CUSTOM, which reads its cutoff and
// percentage from the two customCancellation* fields below. Deliberately a
// listing-level choice, not a platform-wide constant, so different hosts can
// run different policies without a code change.
enum CancellationPolicyKind {
  FLEXIBLE
  MODERATE
  STRICT
  CUSTOM
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// NONE: this booking never needed host approval (Listing.instantBook was
// true at creation) - the overwhelming majority of bookings. The other four
// only ever apply to a Listing.instantBook = false request: AWAITING while
// the host has yet to respond, then exactly one of APPROVED (booking stays
// PENDING, now payable), DECLINED (host said no), or EXPIRED (host never
// responded within REQUEST_HOLD_HOURS) - the latter two both also flip the
// booking's own status straight to CANCELLED, since a request nobody
// accepted was never a reservation to begin with.
enum BookingApprovalStatus {
  NONE
  AWAITING
  APPROVED
  DECLINED
  EXPIRED
}

// Lifecycle of a security-deposit hold (see Listing.securityDepositCents
// and src/lib/securityDeposit.ts). NOT_REQUIRED: the listing had no
// deposit set. AWAITING_AUTHORIZATION: a deposit applies but the actual
// card hold hasn't been placed yet - deliberately deferred to shortly
// before check-in (see DEPOSIT_AUTHORIZATION_WINDOW_DAYS), never at the
// time of the original booking payment, since a card authorization hold
// only lasts about a week and a stay booked months ahead would otherwise
// have its hold expire long before check-in. AUTHORIZED: the hold is live.
// CAPTURED: the host filed a claim and some or all of it was charged.
// RELEASED: the hold was cancelled without a charge, either because the
// claim window closed with no claim filed, or the host explicitly chose
// to release it early.
enum DepositStatus {
  NOT_REQUIRED
  AWAITING_AUTHORIZATION
  AUTHORIZED
  CAPTURED
  RELEASED
}

enum PropertyType {
  APARTMENT
  HOUSE
  HOTEL
  COTTAGE
  VILLA
  STUDIO
  OTHER
}

// PUBLISHED reviews are the only ones any read path should ever return.
// REMOVED exists so a future admin-moderation action has somewhere to land
// without deleting the row outright (preserving the report history that led
// to it). There's no UI to set this yet - it's here so a later moderation
// task doesn't need another migration.
enum ReviewStatus {
  PUBLISHED
  REMOVED
}

enum ReviewReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

// NONE: never started. PENDING: a Stripe Identity VerificationSession is
// open, awaiting the user's document + selfie. VERIFIED/FAILED: Stripe's
// own decision, applied by the identity.verification_session.* webhook
// events - this app never marks a user verified itself, only Stripe does.
enum IdentityVerificationStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  // Set once by self-service account deletion (POST /api/account, see
  // src/lib/accountDeletion.ts) - anonymize-in-place, not a real row
  // delete, since a real DELETE would cascade through every Booking,
  // Review, and Message this account ever touched (most of those
  // relations are onDelete: Cascade), destroying another party's own
  // booking/financial history along with it. A non-null deletedAt means
  // name/email/phone/image have been scrubbed and passwordHash cleared
  // (blocking login); every other row this account created stays exactly
  // as it was.
  deletedAt    DateTime?
  // Null for an account created via an OAuth provider (e.g. Google) that
  // has never also set a password - there's nothing to compare against on
  // a Credentials login, so authorize() must treat null as "deny" rather
  // than passing it to bcrypt.
  passwordHash String?
  role         Role      @default(GUEST)
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // When this account's owner actually agreed to the Terms and Privacy
  // Policy - set once, at account creation, never updated on a later
  // policy change (re-consent on a materially changed policy is a real
  // future gap, not solved here). Nullable rather than defaulted to
  // "now" on migration: an account created before this field existed
  // genuinely has no recorded consent, and defaulting it to the
  // migration's own run time would be a fabricated record, not a fix.
  // Credentials signup requires the checkbox this backs
  // (src/app/api/signup/route.ts); a Google sign-in has no separate
  // consent step, so it's set the moment that account is first created,
  // on the same page (/login or /register) that shows the Terms/Privacy
  // links right by the "Continue with Google" button.
  termsAcceptedAt DateTime?

  // A host's Stripe Express connected account, used to pay them out
  // directly via destination charges (see src/lib/stripeConnect.ts) rather
  // than FYStay holding every guest payment in its own Stripe balance.
  // Null until a host starts onboarding. The two Enabled flags mirror
  // Stripe's own account object exactly (kept in sync by the account.updated
  // webhook) rather than being collapsed into one "ready" flag, since a host
  // can have charges enabled but payouts still restricted (e.g. missing bank
  // details) and the UI needs to tell those apart.
  stripeConnectAccountId        String? @unique
  stripeConnectDetailsSubmitted Boolean @default(false)
  stripeConnectChargesEnabled   Boolean @default(false)
  stripeConnectPayoutsEnabled   Boolean @default(false)

  // Referral program (see src/lib/referral.ts). referralCode is this
  // user's own shareable code; referredByUserId is who they signed up
  // under, if anyone. creditBalanceCents is a spendable wallet (applied
  // automatically to a booking's total in /api/bookings, capped at the
  // booking's own total - see computeCreditToApply), credited to a new
  // signup immediately (their welcome credit) and to the referrer once
  // - guarded by referralBonusAwarded on the REFEREE's own row - when the
  // person they referred completes their first paid booking. Awarding on
  // a real payment, not just a signup, is what keeps this resistant to
  // someone farming throwaway accounts for referrer credit.
  referralCode         String  @unique
  referredByUserId     String?
  referredBy           User?   @relation("Referrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals            User[]  @relation("Referrals")
  creditBalanceCents   Int     @default(0)
  referralBonusAwarded Boolean @default(false)

  // Phone verification (see src/lib/phoneVerification.ts - a Twilio Verify
  // integration, inactive without TWILIO_* env vars, the same pattern as
  // the Ticketmaster events integration). phone is only ever set once it's
  // actually been verified - never a claimed-but-unconfirmed number - so
  // phoneVerifiedAt being non-null is exactly equivalent to phone being
  // non-null; both are kept for a readable "verified when" timestamp.
  phone           String?
  phoneVerifiedAt DateTime?

  // ID verification via Stripe Identity (src/lib/identity.ts) - reuses the
  // Stripe account this app already has for payments rather than a second
  // vendor. NONE/PENDING/FAILED never show a "verified" badge anywhere;
  // only a real VERIFIED from Stripe's own webhook does (see
  // identity.verification_session.* handling in the Stripe webhook route) -
  // this app never marks itself verified.
  identityVerificationStatus IdentityVerificationStatus @default(NONE)
  stripeIdentitySessionId    String?                    @unique
  identityVerifiedAt         DateTime?

  // Optional TOTP two-factor login (see src/lib/twoFactor.ts). The secret
  // is encrypted at rest (never stored or returned in plaintext once
  // enrollment is confirmed) and, like every other "verified" flag in this
  // schema, only counts as active once actually proven: twoFactorSecretCiphertext
  // is set the moment a QR code is generated, but twoFactorEnabledAt stays
  // null - and login is NOT gated - until the user enters one real code
  // back, so a host who scans the QR and never completes setup is never
  // locked out by a secret they don't actually have working. Backup codes
  // are stored hashed (bcrypt, same as passwordHash) - one-time use, each
  // removed from the array the moment it's redeemed.
  twoFactorSecretCiphertext String?
  twoFactorEnabledAt        DateTime?
  twoFactorBackupCodeHashes String[]  @default([])

  // Set by an admin (PATCH /api/admin/users/[id]/suspend) to lock a bad
  // account out of authenticating entirely - see src/lib/suspension.ts and
  // its check in both the Credentials authorize() and Google signIn()
  // callbacks in src/auth.ts. Null (the default, and true of every account
  // that exists today) means active; nullable rather than a boolean flag so
  // "never suspended" and "unsuspended at some point" both stay honest
  // rather than collapsing to the same false, the same reasoning as
  // termsAcceptedAt above. suspendedReason is admin-entered free text shown
  // to the user on their next login attempt - cleared back to null whenever
  // suspendedAt is, never left dangling from a previous suspension.
  suspendedAt     DateTime?
  suspendedReason String?

  // Session revocation counter (see src/auth.ts's jwt callback). Every JWT
  // is stamped with the value current at sign-in; on every later request
  // that stamp is compared against this live column, and a mismatch signs
  // the session out. Bumping this is how a password reset, account
  // deletion, or an admin suspending this account actually invalidates an
  // already-issued token instead of waiting up to 30 days (NextAuth's
  // default JWT session length) for it to expire on its own - and it's
  // also what a self-service "sign out of all devices" button
  // (POST /api/account/sign-out-everywhere) does on demand.
  sessionVersion Int @default(1)

  listings            Listing[]
  bookings            Booking[]
  reviews             Review[]
  savedListings       SavedListing[]
  savedPlaces         SavedPlace[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]
  reviewReports       ReviewReport[]
  guestConversations  Conversation[]       @relation("GuestConversations")
  hostConversations   Conversation[]       @relation("HostConversations")
  sentMessages        Message[]

  // General-purpose support tickets (see SupportTicket's own comment) -
  // distinct from Conversation/Message above, which is guest-host only
  // with no admin visibility, and from PaymentDispute, which is
  // Stripe-chargeback-specific. supportTicketsOpened is every ticket this
  // account raised; supportTicketsAbout is tickets *about* this account
  // raised by someone else (e.g. a guest opening a ticket about a
  // problem host); supportTicketMessagesSent covers messages this account
  // wrote into any ticket, whichever side (opener or admin) they wrote as.
  supportTicketsOpened      SupportTicket[]        @relation("SupportTicketsOpened")
  supportTicketsAbout       SupportTicket[]        @relation("SupportTicketsAbout")
  supportTicketMessagesSent SupportTicketMessage[] @relation("SupportTicketMessagesSent")

  // PMS/channel-manager connections this host has set up (see the Pms*
  // models below) - a host, not a listing, owns a connection, since one
  // Cloudbeds/SiteMinder/SuperControl account on the provider's side
  // typically covers all of a host's properties at once.
  pmsConnections PmsConnection[]

  // Affiliate hotel searches/clicks this account made while signed in - null
  // on both relations for a logged-out guest, exactly like every other
  // optional userId on this schema's tracking tables (see AnalyticsEvent).
  affiliateSearches AffiliateSearch[]
  affiliateClicks   AffiliateClick[]

  // Spotlight placements this host has bought (see ListingPromotion).
  listingPromotions ListingPromotion[]
}

// A single-use, time-limited token for the "forgot password" flow. Only a
// hash of the token is stored, so a database leak alone can't be used to
// reset anyone's password (same principle as storing password hashes, not
// passwords).
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A single-use, time-limited token for the self-service "change email"
// flow (see src/lib/emailChange.ts) - same shape and reasoning as
// PasswordResetToken (only a hash stored, single use, expires), plus the
// actual newEmail the token was issued for, since - unlike a password
// reset - there's no separate field on User to stage a "pending" email
// into; the token row itself is that staging area until it's confirmed.
model EmailChangeToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  newEmail  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Listing {
  id                        String       @id @default(cuid())
  title                     String
  description               String
  city                      String
  country                   String
  address                   String?
  // Both null until the listing's city matches a known Fylde Coast town
  // (see src/lib/geocoding.ts) - never a guessed or user-typed value, so a
  // city FYStay doesn't actually cover never gets a fabricated pin on the
  // map. Town-center coordinates with a small deterministic jitter, not a
  // real street address - this app has no per-property geocoding data.
  latitude                  Float?
  longitude                 Float?
  propertyType              PropertyType @default(OTHER)
  pricePerNightCents        Int
  // A flat, once-per-stay fee (housekeeping between guests), separate from
  // the nightly rate. Zero means the host hasn't set one, in which case the
  // booking summary simply omits that line rather than showing "£0".
  cleaningFeeCents          Int          @default(0)
  // Percentage off the nightly subtotal for stays of 7+ / 28+ nights
  // (Airbnb-style length-of-stay discounts). Null means the host hasn't set
  // one, in which case no discount applies at that threshold - never
  // defaulted to 0 vs null being treated the same, so "not configured" and
  // "explicitly 0%" stay distinguishable if that ever matters. See
  // resolveLengthOfStayDiscount in src/lib/pricing.ts for how these combine.
  weeklyDiscountPercent     Int?
  monthlyDiscountPercent    Int?
  // A last-minute deal: this percentage off the nightly rate for a stay
  // that checks in within lastMinuteWindowDays of the day it's booked. Both
  // null (the default) = no deal. Never stacks with the weekly/monthly
  // discount - the guest gets whichever is larger. See src/lib/deals.ts.
  lastMinuteDiscountPercent Int?
  lastMinuteWindowDays      Int?
  // Price-drop tracking for the "was" price (src/lib/deals.ts): when the
  // nightly price last changed, and - only when a host lowered a price that
  // had been charged for at least 28 days - that earlier price and when it
  // dropped. Shown for 28 days after the drop, so a "was" price is always
  // one the listing genuinely charged for a reasonable time.
  priceChangedAt            DateTime?
  priceDropFromCents        Int?
  priceDroppedAt            DateTime?
  maxGuests                 Int          @default(1)
  bedrooms                  Int          @default(1)
  beds                      Int          @default(1)
  bathrooms                 Int          @default(1)
  photos                    String[]
  amenities                 String[]
  published                 Boolean      @default(true)
  // true (the default, preserving every existing listing's behavior): a
  // guest's booking goes straight to payment, same as today. false: the
  // guest instead submits a request (see Booking.approvalStatus) that the
  // host must accept within REQUEST_HOLD_HOURS before payment is even
  // offered - no card is touched until the host says yes.
  instantBook               Boolean      @default(true)
  // A refundable damage-deposit hold, in addition to the nightly price -
  // never added to a booking's own totalPriceCents, and never actually
  // charged unless the host files a claim (see DepositStatus). 0 (the
  // default) means the host hasn't set one - the same "0 means not
  // configured" convention as cleaningFeeCents.
  securityDepositCents      Int          @default(0)
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  cancellationPolicy              CancellationPolicyKind @default(MODERATE)
  // Only read when cancellationPolicy is CUSTOM; null otherwise. A null
  // value under CUSTOM falls back to a sane default (see
  // resolveCancellationPolicy) rather than failing.
  customCancellationCutoffDays    Int?
  customCancellationRefundPercent Int?

  // Stay length limits, enforced alongside (never folded into) the
  // date-availability check - see the design-intent comment on
  // blockingRanges in src/lib/availability.ts. maxNights null means no cap.
  minNights Int  @default(1)
  maxNights Int?

  // Free-text rather than a structured time type: hosts describe these in
  // their own words ("After 3pm", "Flexible", "By arrangement"), and the
  // site only ever displays them, never computes with them.
  checkInTime  String?
  checkOutTime String?

  // Public house-rule flags, shown on the listing page before booking -
  // distinct from checkInInstructions/wifi below, which are guest-only and
  // only revealed once a booking is actually paid for (see canSeeStayDetails
  // on the booking detail page).
  selfCheckIn     Boolean @default(false)
  smokingAllowed  Boolean @default(false)
  partiesAllowed  Boolean @default(false)
  quietHoursStart String?
  quietHoursEnd   String?
  additionalRules String?

  // Guest-only, revealed after payment - never shown on the public listing
  // page. checkInInstructions covers lockbox codes, key location, or a
  // meet-and-greet note; wifiPassword is meaningless without wifiNetwork so
  // the UI only shows either once both are set.
  checkInInstructions String?
  wifiNetwork         String?
  wifiPassword        String?

  // Calendar sync with other platforms (Airbnb, Vrbo, Google Calendar), so
  // a host who cross-lists elsewhere doesn't get double-booked. Export is a
  // secret-token feed URL (icalExportToken authorizes it without a login,
  // since calendar apps can't send session cookies) listing this listing's
  // CONFIRMED bookings and host-set blocks; import is one external .ics URL
  // the host pastes in, synced into AvailabilityBlock rows tagged
  // ICAL_IMPORT (see src/lib/icalSync.ts). One import URL, not many - most
  // hosts cross-list on a single other platform, and this keeps the sync
  // and its UI simple; multiple imports is a reasonable future extension.
  icalExportToken String    @unique @default(cuid())
  icalImportUrl   String?
  icalSyncedAt    DateTime?

  // Set by an admin (PATCH /api/admin/listings/[id]/suspend) to pull a
  // fraudulent or problem listing out of search/booking without deleting
  // it - see src/lib/suspension.ts. Null (the default) means active. A
  // suspended listing is excluded from every search/browse query
  // (alongside published: true) and can't be booked (see
  // src/app/api/bookings/route.ts), but its own host - and an admin - can
  // still open its detail page to see why. suspendedReason is admin-entered
  // free text; cleared back to null whenever suspendedAt is.
  suspendedAt     DateTime?
  suspendedReason String?

  hostId             String
  host               User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings           Booking[]
  reviews            Review[]
  savedBy            SavedListing[]
  availabilityBlocks AvailabilityBlock[]
  conversations      Conversation[]
  roomTypes          RoomType[]
  pmsRoomMappings    PmsRoomMapping[]
  promotions         ListingPromotion[]

  @@index([city])
  @@index([hostId])
}

// A distinct category of room within a HOTEL-type Listing (e.g. "Standard
// Double", "Deluxe Suite"), each with its own price/capacity/photos and a
// countable inventory (totalRooms identical physical rooms of this type).
// Only ever created under a Listing with propertyType HOTEL - every other
// property type keeps using Listing's own flat price/capacity fields
// directly and has zero RoomType rows. See src/lib/availability.ts's
// isRoomTypeRangeAvailable for how totalRooms is enforced against
// concurrent bookings.
model RoomType {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  pricePerNightCents Int
  maxGuests          Int      @default(2)
  bedrooms           Int      @default(1)
  beds               Int      @default(1)
  bathrooms          Int      @default(1)
  photos             String[]
  // How many identical physical rooms of this type the hotel has. The
  // inventory count that isRoomTypeRangeAvailable checks bookings against -
  // not a per-booking quantity (see Booking.roomsBooked for that).
  totalRooms         Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  bookings           Booking[]
  availabilityBlocks AvailabilityBlock[]
  pmsRoomMappings    PmsRoomMapping[]

  @@index([listingId])
}

enum AvailabilityBlockSource {
  HOST
  ICAL_IMPORT
  // A reservation pulled from a connected PMS/channel manager (Cloudbeds,
  // SiteMinder, SuperControl - see the Pms* models below) that isn't a real
  // FYStay Booking - a guest booked through the PMS or another channel, not
  // through FYStay. Handled exactly like ICAL_IMPORT: externalUid holds the
  // PMS's own reservation id, so a later sync can tell "still there, maybe
  // moved" apart from "gone, delete the block" without ever touching a HOST
  // block. A reservation made *through* FYStay is a real Booking instead
  // (see PmsReservationLink), never one of these.
  PMS_IMPORT
}

// A closure of a date range, independent of any guest Booking: either the
// host manually blocked it (maintenance, personal use, an off-platform
// booking) or it was synced in from an external calendar (see
// src/lib/icalSync.ts). Treated identically to a Booking wherever
// availability is checked (see src/lib/availability.ts's blockingRanges)
// so a blocked date is just as unbookable to a guest as a reserved one,
// while staying visually and structurally distinct on the host's own
// calendar. externalUid is the source .ics feed's own VEVENT UID, present
// only on ICAL_IMPORT rows - it's what lets a later sync tell "this event
// still exists, maybe with new dates" apart from "this event is gone,
// delete the block" without ever touching a HOST block by mistake.
model AvailabilityBlock {
  id          String                  @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  reason      String?
  source      AvailabilityBlockSource @default(HOST)
  externalUid String?
  createdAt   DateTime                @default(now())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Set only when this block belongs to a specific RoomType on a HOTEL
  // listing (see Booking.roomTypeId's own comment for why this mirrors
  // that field) - null for every non-hotel listing's blocks, exactly as
  // today.
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([listingId, externalUid])
  @@index([listingId])
  @@index([roomTypeId])
}

enum PromoDiscountType {
  PERCENT
  FIXED
}

// A platform-wide marketing code (e.g. WELCOME10), created and managed only
// by an ADMIN - never a host, unlike a listing's own weekly/monthly
// length-of-stay discount. code is always stored and matched uppercase (see
// normalizePromoCode in src/lib/promoCode.ts) so "welcome10" and "WELCOME10"
// are the same code. discountValue means a percentage (1-100) under PERCENT
// or a flat pence amount under FIXED - never both, decided entirely by
// discountType. redemptionCount is incremented atomically inside the same
// transaction as the Booking it's used on, so it can never overcount past
// maxRedemptions under concurrent use. active lets an admin retire a code
// without deleting it (and losing the history of who used it).
model PromoCode {
  id              String            @id @default(cuid())
  code            String            @unique
  description     String?
  discountType    PromoDiscountType
  discountValue   Int
  maxRedemptions  Int?
  redemptionCount Int               @default(0)
  expiresAt       DateTime?
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  bookings Booking[]
}

model Booking {
  id            String        @id @default(cuid())
  // A short, human-friendly code shown to the guest (e.g. on the
  // confirmation page and "My trips"), distinct from the internal cuid id.
  reference     String        @unique
  checkIn       DateTime
  checkOut      DateTime
  guests        Int           @default(1)
  nights        Int
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  // Price breakdown, snapshotted at booking time so a later change to the
  // listing's price or fees never rewrites the price a guest already agreed
  // to. totalPriceCents is always (nightlyPriceCents * nights) -
  // lengthOfStayDiscountCents + cleaningFeeCents + serviceFeeCents + taxCents
  // - creditAppliedCents.
  nightlyPriceCents         Int
  // Amount and which threshold (weekly/monthly) applied, snapshotted the
  // same way as the other price fields - a later edit to the listing's
  // discount settings never rewrites what a guest already agreed to.
  // 0/null when no discount applied to this stay.
  // Holds the stay's one discount: weekly/monthly, or a last-minute deal
  // ("last_minute") when that was larger - they never stack.
  lengthOfStayDiscountCents Int        @default(0)
  lengthOfStayDiscountLabel String?
  // The last-minute deal percentage this booking qualified for when it was
  // made (null if none), so a later date change reprices with the same deal
  // instead of quietly taking it away.
  lastMinuteDiscountPercent Int?
  cleaningFeeCents          Int        @default(0)
  serviceFeeCents           Int        @default(0)
  taxCents                  Int        @default(0)
  // Referral-program credit spent on this booking (see User.creditBalanceCents
  // in referral.ts) - deducted from the guest's balance at booking creation
  // and absorbed out of the platform's own applicationFeeCents at checkout,
  // never the host's share. 0 when the guest had no balance to spend.
  creditAppliedCents        Int        @default(0)
  // An admin-issued PromoCode's discount, snapshotted the same way as every
  // other price field - editing or deactivating the code later never
  // rewrites what a guest already agreed to. Stacks with creditAppliedCents
  // (both can be nonzero on the same booking) and is absorbed the same way:
  // out of the platform's own applicationFeeCents at checkout, never the
  // host's share - see promoCode.ts's own comment for why. 0/null when no
  // code was used.
  promoCodeId               String?
  promoCode                 PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoDiscountCents        Int        @default(0)
  totalPriceCents           Int

  // Request-to-book (see Listing.instantBook and BookingApprovalStatus).
  // requestExpiresAt is only ever set alongside approvalStatus AWAITING -
  // the deadline by which the host must respond before
  // expireStaleBookingRequests treats the request as expired.
  // hostRespondedAt is when the host actually approved/declined (or, for
  // an EXPIRED request, when the expiry itself was processed) - distinct
  // from paidAt, which is about the guest's payment, not the host's
  // decision.
  approvalStatus   BookingApprovalStatus @default(NONE)
  requestExpiresAt DateTime?
  hostRespondedAt  DateTime?

  // Security deposit hold (see Listing.securityDepositCents,
  // src/lib/securityDeposit.ts, and DepositStatus's own comment).
  // securityDepositCents is a snapshot from the listing at booking time,
  // like every other price field on this model - never part of
  // totalPriceCents. stripeDepositPaymentIntentId is only set once
  // AUTHORIZED; depositCapturedCents is only set once CAPTURED, and may be
  // less than securityDepositCents (a partial claim). depositClaimDeadline
  // is when an AUTHORIZED hold auto-releases if the host files no claim -
  // set once, at authorization time, to checkOut + DEPOSIT_CLAIM_WINDOW_DAYS.
  securityDepositCents         Int           @default(0)
  depositStatus                DepositStatus @default(NOT_REQUIRED)
  stripeDepositSessionId       String?       @unique
  stripeDepositPaymentIntentId String?
  depositAuthorizedAt          DateTime?
  depositCapturedCents         Int?
  depositCapturedAt            DateTime?
  depositReleasedAt            DateTime?
  depositClaimDeadline         DateTime?

  // Contact details for this specific stay, captured at checkout. Kept on
  // the booking (rather than read live off the account) so the record
  // reflects who the reservation was actually for even if the account's
  // own name/email changes later.
  guestName  String?
  guestEmail String?
  guestPhone String?

  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  // True only when this booking's payment actually routed to the host's
  // Stripe Connect account via transfer_data (see src/lib/stripeConnect.ts) -
  // never just because the host has one today, since they may have
  // connected after this booking was already paid for. Read before issuing
  // a refund: reverse_transfer/refund_application_fee only make sense, and
  // only succeed, on a PaymentIntent that actually carried a transfer.
  hostPaidViaConnect    Boolean   @default(false)
  // The platform fee actually applied at charge time (application_fee_amount
  // on the PaymentIntent), snapshotted separately from serviceFeeCents -
  // normally identical, but kept apart so a future change to the fee rate
  // never rewrites what was actually charged on an existing booking.
  applicationFeeCents   Int?
  paidAt                DateTime?
  refundedAt            DateTime?
  // The actual amount returned to the guest on cancellation, per the
  // listing's cancellation policy at the time. May be less than
  // totalPriceCents (partial refund) or 0 (no refund) - never assume a
  // cancelled, previously-paid booking was refunded in full.
  refundedAmountCents   Int?

  // Idempotency for the automated lifecycle emails in
  // src/app/api/cron/booking-lifecycle-emails/route.ts - each is sent at
  // most once per booking, so the cron can run daily without re-notifying
  // a guest it already reached. Null means "not sent yet", not "N/A" -
  // both are meaningful on every booking, including a cancelled one that
  // never reaches either window.
  arrivalReminderSentAt     DateTime?
  reviewRequestSentAt       DateTime?
  // The one-time "did you want an airport transfer?" nudge (see
  // needsTransferUpsellEmail) - sent once per booking regardless of
  // whether a transfer is ever added, so this stays null forever only for
  // a booking that never reached CONFIRMED at all.
  transferUpsellEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Set only for a booking against a HOTEL listing's RoomType; null (and
  // roomsBooked left at its default of 1) for every non-hotel booking,
  // exactly matching today's one-listing-one-unit behavior. Restrict, not
  // Cascade, so a host can never delete a RoomType out from under a real
  // Booking record - see the room-types DELETE route, which enforces the
  // same rule at the app level with a friendlier error before this
  // constraint would ever fire.
  roomTypeId  String?
  roomType    RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  // How many rooms of roomType this single reservation covers. Always 1
  // for a non-hotel booking. nightlyPriceCents already bakes this in (it's
  // the whole-reservation per-night total, i.e. roomType.pricePerNightCents
  // * roomsBooked at booking time) - this field is inventory-count
  // metadata for the availability check and receipts, not a pricing
  // multiplier applied elsewhere.
  roomsBooked Int       @default(1)

  guestId String
  guest   User   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  review         Review?
  changeRequests BookingChangeRequest[]

  // Set once this booking has been pushed to a connected PMS (see
  // PmsReservationLink's own comment) - null for a booking on a listing
  // with no PMS connection, or one not yet pushed. A reservation that
  // exists only on the PMS side (a guest who booked through Cloudbeds
  // directly) is never a Booking row at all - see AvailabilityBlockSource.PMS_IMPORT.
  pmsReservationLink PmsReservationLink?

  // Paid add-ons purchased against this stay (airport transfer, attraction
  // tickets, car hire, ...) - see docs/trip-extras-roadmap.md and
  // BookingExtra's own comment. Empty on every booking until a guest buys
  // one; never affects totalPriceCents or this booking's own paymentStatus,
  // since each is its own separate charge.
  extras BookingExtra[]

  // A bank-initiated chargeback against this booking's own payment - see
  // PaymentDispute's own comment for why this is a separate audit record
  // rather than a new PaymentStatus value. Almost always empty; a real
  // stay can have more than one disputed charge in principle (e.g. a
  // change-request payment disputed separately from the original), so
  // this is a list, not a nullable single relation.
  disputes PaymentDispute[]

  // Support tickets that reference this specific booking as context (see
  // SupportTicket.bookingId's own comment) - almost always empty; most
  // tickets aren't about any one booking.
  supportTickets SupportTicket[]

  @@index([listingId])
  @@index([guestId])
  @@index([roomTypeId, checkIn, checkOut])
}

// A guest-initiated request to change a CONFIRMED booking's dates or guest
// count, subject to host approval. Kept separate from Booking itself so the
// original booking stays untouched (and its dates keep blocking availability
// for other guests) until the host actually approves the change, and so a
// price increase can be collected via its own Stripe Checkout session before
// the change is applied, mirroring how the initial booking payment works.
model BookingChangeRequest {
  id     String              @id @default(cuid())
  status ChangeRequestStatus @default(PENDING)

  requestedCheckIn  DateTime
  requestedCheckOut DateTime
  requestedGuests   Int
  // priceDeltaCents - the original booking's totalPriceCents at
  // request time. Positive: guest owes more. Negative: guest is due a
  // refund. Zero: applied immediately on approval, no payment step.
  priceDeltaCents   Int

  // Snapshot of the booking's own values at the moment this request was
  // created. The booking itself gets overwritten once a change is applied,
  // so without this snapshot there would be no way to show "before vs
  // after" once that's happened - originalTotalPriceCents + priceDeltaCents
  // always equals the requested total, regardless of what the booking looks
  // like by the time someone reads this request back.
  originalCheckIn         DateTime
  originalCheckOut        DateTime
  originalGuests          Int
  originalTotalPriceCents Int

  stripeSessionId     String?   @unique
  // Same meaning as Booking.hostPaidViaConnect/applicationFeeCents - this
  // extra payment for an approved change gets its own destination charge,
  // separate from the original booking's.
  hostPaidViaConnect  Boolean   @default(false)
  applicationFeeCents Int?
  paidAt              DateTime?
  refundedAt          DateTime?
  respondedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Review {
  id        String   @id @default(cuid())
  // Overall rating - always required. The five below are each optional:
  // a guest may rate as many or as few aspects of the stay as they like.
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  cleanlinessRating   Int?
  accuracyRating      Int?
  communicationRating Int?
  locationRating      Int?
  valueRating         Int?

  // The host's reply, shown under the review. Nullable/unset until the host
  // responds; re-savable, so respondedAt reflects the most recent edit.
  hostResponse    String?
  hostRespondedAt DateTime?

  status ReviewStatus @default(PUBLISHED)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // One review per completed stay - this FK is also what makes every review
  // in the system a "verified stay": there is no path to create a Review
  // that isn't tied to a real Booking by this same guest.
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  reports ReviewReport[]

  @@index([listingId])
}

// A guest's flag on a review for moderation attention. Reporting is real
// (POST /api/reviews/[id]/report); acting on a report (dismissing it,
// setting the review's status to REMOVED, or surfacing it in an admin queue)
// is not yet built, but the data those later features need already exists.
model ReviewReport {
  id        String             @id @default(cuid())
  reason    String
  details   String?
  status    ReviewReportStatus @default(OPEN)
  createdAt DateTime           @default(now())

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  // A guest can flag a given review at most once.
  @@unique([reviewId, reporterId])
  @@index([reviewId])
}

// One thread per guest+listing pair, not per booking - a guest asking a
// question before booking and the same guest coordinating check-in after
// paying belong in the same conversation with that host about that
// property, not fragmented across separate threads. hostId is redundant
// with listing.hostId in principle, but stored directly so a listing being
// edited (or, one day, transferred) never silently moves an existing
// conversation to a different host mid-thread.
model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  guestId String
  guest   User   @relation("GuestConversations", fields: [guestId], references: [id], onDelete: Cascade)

  hostId String
  host   User   @relation("HostConversations", fields: [hostId], references: [id], onDelete: Cascade)

  messages Message[]

  @@unique([listingId, guestId])
  @@index([hostId])
  @@index([guestId])
}

model Message {
  id        String    @id @default(cuid())
  body      String
  createdAt DateTime  @default(now())
  // Null until the *other* participant reads it - a sender's own messages
  // are never marked read against themselves, so this alone is enough to
  // compute an unread count without a separate per-recipient read table.
  readAt    DateTime?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// A fixed-window request counter for lightweight abuse protection on
// unauthenticated, high-risk endpoints (login, signup, password reset) - see
// src/lib/rateLimit.ts. Deliberately just a counter keyed by an arbitrary
// string (e.g. "login:someone@example.com") with no relations to anything
// else in the schema, so it can be pruned or reset without touching real
// application data.
model RateLimitHit {
  key         String   @id
  windowStart DateTime
  count       Int

  // Indexed for the opportunistic "delete anything long stale" sweep in
  // src/lib/rateLimit.ts, which would otherwise be a full table scan every
  // time it runs.
  @@index([windowStart])
}

model SavedListing {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

// ============================================================================
// Live local-data platform (Local Guide) - a cached, unified view over
// several free/keyless external sources (OpenStreetMap/Overpass, Open-Meteo,
// Ticketmaster Discovery) plus FYStay's own hand-written editorial layer.
// The app never calls these external APIs from a component or the browser -
// only from src/lib/localData/*, which reads/writes the tables below. See
// that directory's own doc comments for the source-by-source detail.
// ============================================================================

enum LocalDataSource {
  OSM
  TICKETMASTER
  OPEN_METEO
  EDITORIAL
}

enum LocalPlaceCategory {
  RESTAURANT
  CAFE
  PUB
  SHOP
  SUPERMARKET
  PHARMACY
  PARK
  BEACH
  PLAYGROUND
  ATTRACTION
  MUSEUM
  TOILET
  PARKING
  EV_CHARGING
  VIEWPOINT
  OTHER
}

enum EditorialTag {
  FYSTAY_PICK
  HIDDEN_GEM
  BEST_FOR_FAMILIES
  BEST_FOR_COUPLES
  BEST_CHEAP_EAT
  BEST_BREAKFAST
  BEST_BEACH
  BEST_WALK
  BEST_RAINY_DAY
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  FAILURE
  // The source was never called at all this run - e.g. Ticketmaster with
  // no TICKETMASTER_API_KEY configured. Distinct from FAILURE so the admin
  // dashboard can tell "broken" apart from "not switched on yet".
  SKIPPED
}

// One row per Fylde Coast town FYStay covers - a real table (rather than
// re-deriving src/lib/destinations.ts's FYLDE_COAST_DESTINATIONS constant
// in SQL) so every table below can be queried and reported on by town.
// Seeded from, and kept in sync with, that same constant - see
// src/lib/localData/seedTowns.ts.
model LocalTown {
  slug      String @id
  name      String
  latitude  Float
  longitude Float

  places    LocalPlace[]
  events    LocalEvent[]
  weather   WeatherCache?
  editorial EditorialRecommendation[]
}

// The unified local-place record every external source normalizes into -
// a restaurant from OpenStreetMap and a hand-written FYStay editorial pick
// live in the same shape, so the recommendation engine
// (src/lib/localData/recommendationEngine.ts) can rank them together
// without caring which source a place came from.
model LocalPlace {
  id     String          @id @default(cuid())
  source LocalDataSource

  // The source's own id for this place (an OSM node/way id, etc.) - null
  // for a place with no external id yet. Nulls don't collide under the
  // unique index below, so any number of sourceId-less rows can coexist.
  sourceId String?

  townSlug String
  town     LocalTown @relation(fields: [townSlug], references: [slug], onDelete: Cascade)

  name           String
  category       LocalPlaceCategory
  description    String?
  latitude       Float
  longitude      Float
  address        String?
  // Raw OSM opening_hours syntax (e.g. "Mo-Fr 09:00-17:30") when the
  // source provides it - kept as the source's own text rather than
  // reshaped into a custom schema, since opening_hours syntax already has
  // a real parser (src/lib/localData/openingHours.ts) and reformatting it
  // ourselves risks silently losing information.
  openingHours   String?
  website        String?
  phone          String?
  rating         Float?
  priceLevel     Int?
  imageUrl       String?
  // Tri-state, not boolean: most source records simply don't tag this at
  // all, which is a real "unknown" - collapsing that to false would
  // assert something the data never actually said.
  familyFriendly Boolean?
  dogFriendly    Boolean?
  // The source's own accessibility tag (OSM's wheelchair=yes/no/limited)
  // kept as text rather than an enum, so a future source's own vocabulary
  // doesn't fail an upsert just for being unexpected.
  accessibility  String?

  // The full normalized source payload, for debugging a bad-looking
  // record without re-fetching it from the source.
  rawData Json?

  lastFetchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  editorial EditorialRecommendation[]
  savedBy   SavedPlace[]

  @@unique([source, sourceId])
  @@index([townSlug, category])
}

model LocalEvent {
  id       String          @id @default(cuid())
  source   LocalDataSource @default(TICKETMASTER)
  sourceId String          @unique

  townSlug String
  town     LocalTown @relation(fields: [townSlug], references: [slug], onDelete: Cascade)

  name       String
  category   String
  venueName  String?
  latitude   Float?
  longitude  Float?
  startsAt   DateTime
  endsAt     DateTime?
  url        String?
  imageUrl   String?
  priceRange String?

  rawData Json?

  lastFetchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([townSlug, startsAt])
}

// One row per town, replaced wholesale on every refresh rather than kept
// as history - a guest only ever needs the latest forecast, and Open-
// Meteo's own hourly/daily arrays already cover "what's the weather doing
// over my stay", so there's nothing to gain from keeping old rows around.
model WeatherCache {
  townSlug String    @id
  town     LocalTown @relation(fields: [townSlug], references: [slug], onDelete: Cascade)

  // Open-Meteo's own current/daily response shapes, stored as-is (see
  // src/lib/localData/weather.ts for the normalized view built from this
  // on read) rather than flattened into columns - a field Open-Meteo adds
  // later, or one this app starts using, needs no migration.
  current Json
  daily   Json

  fetchedAt DateTime @default(now())
}

// FYStay's own manually-written layer on top of (or ahead of) live data -
// this is what makes the guide read as curated rather than a raw API
// dump. Not required to reference a LocalPlace: an editorial pick written
// before any live source has that place synced still needs somewhere to
// live, so `placeId` is optional and the entry carries its own
// name/description until a real place row exists to link to.
model EditorialRecommendation {
  id   String @id @default(cuid())
  slug String @unique

  townSlug String
  town     LocalTown @relation(fields: [townSlug], references: [slug], onDelete: Cascade)

  placeId String?
  place   LocalPlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  tag         EditorialTag
  name        String
  category    LocalPlaceCategory
  description String
  // Lower sorts first within the same town+tag - lets a small number of
  // picks be ordered deliberately rather than falling back to insertion
  // order or alphabetical.
  rank        Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([townSlug, tag])
}

model SavedPlace {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  placeId String
  place   LocalPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}

// One row per sync attempt, kept for the admin dashboard's "API status"
// view (src/app/admin/local-data/page.tsx) - a running log rather than a
// single "last sync" row per source, so a string of recent failures stays
// visible instead of being masked by the next success.
model ApiSyncLog {
  id           String          @id @default(cuid())
  source       LocalDataSource
  townSlug     String?
  status       SyncStatus
  recordCount  Int             @default(0)
  errorMessage String?
  startedAt    DateTime
  finishedAt   DateTime

  @@index([source, startedAt])
}

// ============================================================================
// PMS / channel-manager integrations (Cloudbeds, SiteMinder, SuperControl) -
// a provider-agnostic layer so a host's existing property-management system
// stays the source of truth for inventory/rates while FYStay syncs against
// it, rather than every host having to manage two separate calendars by
// hand. See src/lib/pms/types.ts for the adapter interface every provider
// implements, and src/lib/pms/sync.ts for the actual sync logic that reads
// and writes the models below - deliberately reusing this codebase's own
// existing patterns rather than inventing parallel ones:
//   - an imported PMS reservation becomes an AvailabilityBlock (source
//     PMS_IMPORT), exactly like an iCal import - it's an external booking
//     blocking a date range, not a FYStay Booking with a guest account and
//     a Stripe payment.
//   - sync history is a running log (PmsSyncLog), the same shape as
//     ApiSyncLog above, for the same reason: a string of recent failures
//     stays visible on the host's integrations page instead of being
//     masked by the next success.
//   - authorization on every route touching these models starts with this
//     codebase's own established convention (a NextAuth session + an
//     explicit hostId/ownership check in the route handler, the same as
//     every Listing/Booking/RoomType route) - this app's database access
//     otherwise goes entirely through Prisma with a single server-side
//     connection, not per-user Postgres roles or PostgREST, so there is no
//     request-scoped DB identity for RLS to key off anywhere else in this
//     schema. These five tables are the exception: they carry another
//     party's credentials and sync history, so they also get real Postgres
//     Row Level Security as defense-in-depth on top of the application
//     check, via a second, restricted DB role scoped to app.current_host_id
//     for the duration of one request - see the
//     20260914070000_add_pms_row_level_security migration and
//     src/lib/pms/hostScopedPrisma.ts for exactly how. The nightly
//     reconciliation cron and the inbound webhook receiver are trusted
//     system jobs that must see every host's connections, so they
//     intentionally keep using the plain, unscoped Prisma client.
// ============================================================================

enum PmsProvider {
  CLOUDBEDS
  SITEMINDER
  SUPERCONTROL
}

// DISCONNECTED: never connected, or the host disconnected it - credentials
// are cleared. CONNECTED: authenticated and syncing normally. ERROR: was
// connected but the last authenticated call failed in a way that needs the
// host's attention (an expired/revoked token, a provider-side account
// issue) - distinct from a single failed sync (see PmsSyncLog), which
// doesn't necessarily mean the connection itself is broken.
enum PmsConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum PmsSyncKind {
  AVAILABILITY
  RATES
  RESTRICTIONS
  RESERVATIONS_IMPORT
  RESERVATION_PUSH
  CANCELLATION_PUSH
  // A full pull of availability + rates + restrictions + reservations in
  // one pass - what "Sync now" and the nightly reconciliation cron both
  // run, as opposed to the narrower kinds above (mostly useful for
  // per-resource retries and for reading the log by what actually changed).
  FULL_RECONCILE
}

// One PMS/channel-manager account per host per provider - a host connects
// their existing Cloudbeds/SiteMinder/SuperControl account once, and it
// covers every property that account manages, not one connection per
// FYStay listing (see PmsRoomMapping for the per-listing/room-type detail).
model PmsConnection {
  id       String              @id @default(cuid())
  provider PmsProvider
  status   PmsConnectionStatus @default(DISCONNECTED)

  // The provider's own identifiers for the connected property, once known
  // (populated after the host picks which property to import from, for a
  // provider account that manages more than one). Purely descriptive -
  // never used to authorize anything - the encrypted credentials below are
  // what every actual API call authenticates with.
  externalPropertyId   String?
  externalPropertyName String?

  // Provider credentials (OAuth tokens, or an API key/secret pair,
  // depending on the provider), encrypted at rest with AES-256-GCM (see
  // src/lib/pms/crypto.ts) using a server-only key (PMS_ENCRYPTION_KEY) -
  // never stored in plaintext, and never sent to the browser. Stored as one
  // opaque ciphertext blob (JSON-shaped once decrypted) rather than
  // separate columns, since each provider's credential shape differs
  // (Cloudbeds: OAuth access/refresh token pair; a provider without OAuth
  // might just be an API key) and a shared column set would either force a
  // common shape that doesn't fit every provider or need a schema change
  // per provider added.
  credentialsCiphertext String?
  // Only meaningful for an OAuth-based provider's access token - null for
  // a provider authenticated by a long-lived API key. Checked before each
  // authenticated call so the adapter can refresh proactively rather than
  // waiting for a 401.
  tokenExpiresAt        DateTime?

  connectedAt    DateTime?
  disconnectedAt DateTime?

  // Denormalized from the most recent PmsSyncLog row for this connection,
  // so the integrations dashboard can show "Last sync: 2 minutes ago"
  // without a join/aggregate on every page load - the full history is
  // still in PmsSyncLog for the "view errors" detail.
  lastSyncedAt   DateTime?
  lastSyncStatus SyncStatus?
  lastSyncError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostId String
  host   User   @relation(fields: [hostId], references: [id], onDelete: Cascade)

  roomMappings     PmsRoomMapping[]
  reservationLinks PmsReservationLink[]
  syncLogs         PmsSyncLog[]
  webhookEvents    PmsWebhookEvent[]

  @@unique([hostId, provider])
  @@index([hostId])
}

// Maps one PMS room/rate-plan to one FYStay Listing (or, for a HOTEL
// listing, one specific RoomType within it) - what lets availability/rates
// sync know which FYStay record a given PMS room's numbers belong to.
// listingId is always set (a mapping always targets a specific FYStay
// listing); roomTypeId is set only when that listing is a HOTEL with
// multiple room types and this mapping is for one of them - the same
// "listing always, room type only for hotels" shape Booking itself uses.
model PmsRoomMapping {
  id String @id @default(cuid())

  externalRoomId   String
  externalRoomName String?

  connectionId String
  connection   PmsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([connectionId, externalRoomId])
  @@index([listingId])
  @@index([roomTypeId])
}

// Links one real FYStay Booking (a guest who booked and paid through
// FYStay) to the reservation it was pushed to on the connected PMS - the
// idempotency record that stops a booking being pushed twice (see
// src/lib/pms/sync.ts's pushReservation, which always checks for an
// existing row here first) and what a cancellation push updates rather
// than creating a second record. A PMS-side reservation that did *not*
// originate as a FYStay Booking (a guest who booked through the PMS or
// another channel) is never represented here - see
// AvailabilityBlockSource.PMS_IMPORT for that direction instead.
model PmsReservationLink {
  id String @id @default(cuid())

  connectionId String
  connection   PmsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Null until the push has actually succeeded at least once.
  externalReservationId String?

  pushStatus   SyncStatus?
  pushError    String?
  pushAttempts Int         @default(0)
  pushedAt     DateTime?

  // Set once this booking's cancellation has been pushed to the PMS -
  // independent of pushStatus, since a booking can only be cancelled on
  // the PMS after it was successfully created there.
  cancelPushStatus   SyncStatus?
  cancelPushError    String?
  cancelPushAttempts Int         @default(0)
  cancelPushedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // externalReservationId is only unique per connection once populated;
  // left un-indexed as a compound unique since it's null on every row that
  // hasn't pushed successfully yet, and Postgres treats each NULL as
  // distinct under a unique index, which is exactly the behavior wanted
  // here (many not-yet-pushed rows can coexist).
  @@unique([connectionId, externalReservationId])
  @@index([connectionId])
}

// One row per sync attempt, same shape and reasoning as ApiSyncLog: a
// running log rather than a single "last sync" row, so a string of recent
// failures stays visible on the host's integrations page instead of being
// masked by the next success. PmsConnection.lastSyncedAt/lastSyncStatus is
// the denormalized "latest" view for the dashboard's summary card; this
// table is the "view errors" detail behind it.
model PmsSyncLog {
  id           String      @id @default(cuid())
  kind         PmsSyncKind
  status       SyncStatus
  recordCount  Int         @default(0)
  errorMessage String?
  startedAt    DateTime
  finishedAt   DateTime

  connectionId String
  connection   PmsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
}

// Idempotency record for an inbound webhook delivery - a provider's own
// event id, deduplicated per provider so a redelivered webhook (every
// provider's own retry policy assumes at-least-once delivery) is processed
// at most once. Mirrors how the Stripe webhook route already guards
// against a redelivered checkout.session.completed event, applied to PMS
// webhooks the same way.
model PmsWebhookEvent {
  id              String      @id @default(cuid())
  provider        PmsProvider
  externalEventId String
  eventType       String
  payload         Json

  processedAt  DateTime?
  status       SyncStatus?
  errorMessage String?
  receivedAt   DateTime    @default(now())

  // Nullable: a webhook can arrive for a connection that's since been
  // disconnected (or, in principle, before FYStay can resolve which
  // connection it belongs to) - kept for the audit trail either way rather
  // than rejected outright.
  connectionId String?
  connection   PmsConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([connectionId])
}

// --- Trip extras (see docs/trip-extras-roadmap.md) ---
//
// FYStay-sold add-ons alongside a stay - airport transfers, attraction
// tickets, car hire - rather than a plain accommodation-only marketplace.
// Each is its own separate Stripe charge to FYStay's own platform account
// (never Stripe Connect: this is FYStay's own product, not a host's
// nightly rate), fulfilled in this first phase by emailing the provider a
// booking request rather than a real system-to-system API - see
// ExtraProvider and BookingExtra's own comments for why.

enum ExtraCategory {
  AIRPORT_TRANSFER
  ATTRACTION_TICKET
  CAR_HIRE
}

enum BookingExtraStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
}

// Where a paid BookingExtra's handoff to its provider has got to - the
// contract docs/trip-extras-roadmap.md's Phase 3 puts every provider
// integration behind (src/lib/tripExtraFulfillment.ts). Independent of
// BookingExtraStatus: payment succeeding and the provider actually
// accepting the job are different things. PENDING = paid, not handed off
// yet; SENDING = one attempt has claimed it (so a retried webhook can't
// send it twice); SENT = the provider has it, not yet confirmed; CONFIRMED
// = the provider confirmed (automatically via an API adapter, or an admin
// recording the email/phone confirmation); FAILED = the handoff failed and
// needs a retry or manual follow-up.
enum ExtraFulfillmentStatus {
  PENDING
  SENDING
  SENT
  CONFIRMED
  FAILED
}

// A business FYStay resells add-ons for - EV Exec (airport transfers) is
// the first. Deliberately not a User: these are FYStay's own commercial
// partners, not accounts that log in to the platform, at least in this
// phase - see the roadmap's Phase 3 for real provider-API integrations,
// which may eventually give a provider its own portal.
model ExtraProvider {
  id                String        @id @default(cuid())
  // Unique so the seed script (and any future admin "add provider" form)
  // can upsert by name instead of risking duplicate rows for the same real
  // business.
  name              String        @unique
  // Every offering under a provider is technically free to have its own
  // category, but in practice one provider (EV Exec, a car-hire company, a
  // ticketing partner) sells one kind of thing - denormalized here mainly
  // so admin listing/filtering doesn't need a join.
  category          ExtraCategory
  // Where a paid BookingExtra's job is actually sent today (see
  // src/lib/notificationEmails.ts) - the only field Phase 1 fulfillment
  // reads. bookingFormUrl is the provider's own existing booking page
  // (EV Exec already has one), kept for reference/fallback even though
  // nothing yet links a guest to it directly.
  notificationEmail String
  bookingFormUrl    String?
  // Which fulfillment adapter hands this provider's paid jobs over (see
  // src/lib/tripExtraFulfillment.ts's registry). "email" - the Phase 1
  // behavior - until the provider has a real API adapter; an unknown code
  // fails closed (FAILED, visible on /admin/extras), never silently.
  integration       String        @default("email")
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  offerings ExtraOffering[]
}

// One bookable, priced thing a provider sells through FYStay (e.g. "Return
// airport transfer"). priceCents is what FYStay charges the guest for it -
// see BookingExtra's own comment on why the actual charge is snapshotted
// separately rather than always read live from here.
model ExtraOffering {
  id          String        @id @default(cuid())
  name        String
  description String?
  category    ExtraCategory
  priceCents  Int
  active      Boolean       @default(true)
  // Short marketing bullets ("Fixed pricing", "Tesla / fully electric",
  // "Meet & greet"...), shown identically wherever this offering is cross-
  // sold (homepage, property page, booking flow, confirmation, account) -
  // one place to edit copy that appears in five surfaces, rather than each
  // surface hardcoding its own list. Empty for a category that doesn't
  // need them; never required.
  features    String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  providerId String
  provider   ExtraProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  bookingExtras BookingExtra[]

  // Unique per provider (not globally) so the seed script can upsert by
  // (provider, name) - two different providers are free to each sell
  // something called e.g. "Standard package".
  @@unique([providerId, name])
  @@index([providerId])
}

// One purchased add-on against a Booking. priceCents is snapshotted at
// purchase time - the same principle as every price field on Booking
// itself - so a later change to the offering's price never rewrites what a
// guest already agreed to pay. onDelete: Restrict on offeringId, like
// RoomType's own FK from Booking, so a provider's offering can never be
// deleted out from under a real purchase.
model BookingExtra {
  id         String             @id @default(cuid())
  priceCents Int
  status     BookingExtraStatus @default(PENDING_PAYMENT)

  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  paidAt                DateTime?

  // Freeform details the guest gives at purchase time that the provider
  // actually needs (flight number/arrival time, pickup/drop-off address,
  // ...) - deliberately not structured per-category columns, since each
  // ExtraCategory needs different details and Phase 1 fulfillment is a
  // human-read email, not a machine-read payload (see the roadmap's Phase 3
  // for when a real API might warrant structured fields instead).
  guestNotes String?

  // Set once the provider notification email actually sends (see
  // src/lib/notificationEmails.ts's sendTripExtraProviderEmail) -
  // independent of status, since payment succeeding and the email actually
  // going out are two different things worth tracking separately.
  sentToProviderAt DateTime?

  // Phase 3 fulfillment contract - see ExtraFulfillmentStatus. Reference is
  // the provider's own booking id/confirmation code once known; error is
  // the last failure's reason, shown to admins (never guests).
  fulfillmentStatus      ExtraFulfillmentStatus @default(PENDING)
  fulfillmentReference   String?
  fulfillmentError       String?
  fulfillmentAttempts    Int                    @default(0)
  fulfillmentConfirmedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  offeringId String
  offering   ExtraOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)

  disputes PaymentDispute[]

  @@index([bookingId])
  @@index([offeringId])
  @@index([fulfillmentStatus])
}

// A bank-initiated chargeback (Stripe's own "dispute" object) against a
// payment this app took. Deliberately its own record rather than a new
// Booking.paymentStatus value: a dispute has its own lifecycle (opened ->
// under review -> won/lost, with an evidence deadline in between) that's
// orthogonal to the booking's own status/refund state, and a booking can
// still be CONFIRMED/PAID while a dispute against it is actively being
// fought. Nothing in this app automates a response - Stripe's own
// dashboard is where evidence actually gets submitted - this table exists
// so a dispute is never something only visible by happening to check
// Stripe's dashboard, and so /admin/disputes can surface the evidence
// deadline before it's missed (a missed deadline is an automatic loss).
enum DisputeStatus {
  WARNING_NEEDS_RESPONSE
  WARNING_UNDER_REVIEW
  WARNING_CLOSED
  NEEDS_RESPONSE
  UNDER_REVIEW
  WON
  LOST
  // Stripe/network-level dispute prevention (e.g. Visa/Mastercard programs
  // that intercept a would-be chargeback before it's charged against the
  // merchant) - included for completeness since Stripe's API can send it,
  // not something this app's own logic branches on specially.
  PREVENTED
}

model PaymentDispute {
  id                    String        @id @default(cuid())
  stripeDisputeId       String        @unique
  stripeChargeId        String
  stripePaymentIntentId String?
  amountCents           Int
  // Stripe's own reason code (e.g. "fraudulent", "product_not_received") -
  // stored as-is rather than mapped to an enum, since Stripe documents
  // more values than are worth modeling here and may add more over time;
  // this is a display/triage field, not something this app branches on.
  reason                String
  status                DisputeStatus
  // Null when Stripe reports no response window for this particular
  // dispute (evidence_details.due_by can be 0/absent) - never treated as
  // "no deadline" by the admin UI, which is why it's nullable rather than
  // defaulted to some far-future date.
  evidenceDueBy         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Both nullable and independent (not exactly one of the two): resolving
  // the disputed charge back to a specific Booking or BookingExtra is a
  // best-effort lookup by payment intent id at webhook time, and this
  // remains a useful audit record even on the rare event neither lookup
  // succeeds.
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  bookingExtraId String?
  bookingExtra   BookingExtra? @relation(fields: [bookingExtraId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([bookingExtraId])
  @@index([status])
}

// General-purpose escalation to FYStay support, for anything that doesn't
// fit the two narrower existing paths: PaymentDispute (Stripe-chargeback-
// specific, driven entirely by Stripe's own webhook) and Conversation/
// Message (guest-host only - a host or a guest with a problem the other
// party can't or won't resolve has nowhere else to go). Modeled as a
// three-party thread (opener, optional about-user, and support) rather than
// the two-party shape Conversation uses, which is why each message needs
// its own isAdminReply flag - see SupportTicketMessage.
enum SupportTicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String              @id @default(cuid())
  subject   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  // Bumped on every new message (opener or admin), the same way
  // Conversation.updatedAt is, so the admin queue's "last activity" sort
  // and the opener's own ticket list both reflect the thread, not just
  // status changes.
  updatedAt DateTime            @updatedAt

  openedById String
  openedBy   User   @relation("SupportTicketsOpened", fields: [openedById], references: [id], onDelete: Cascade)

  // Optional context: who/what this ticket is about, so support has
  // enough to act without the opener re-explaining it in the first
  // message. Both nullable - a ticket can be a general question with
  // neither.
  aboutUserId String?
  aboutUser   User?    @relation("SupportTicketsAbout", fields: [aboutUserId], references: [id], onDelete: SetNull)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  messages SupportTicketMessage[]

  @@index([openedById])
  @@index([status])
}

model SupportTicketMessage {
  id           String   @id @default(cuid())
  body         String
  // True when this message was written by an admin acting in a support
  // capacity, false when it's from the ticket's own opener - drives which
  // side of the thread it renders on, the same way Message doesn't need
  // this (both participants there are just "the other side") but here the
  // three-party shape (opener, optional about-user, support) needs it.
  isAdminReply Boolean  @default(false)
  createdAt    DateTime @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SupportTicketMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// A generic, append-only event log for measuring cross-sell/add-on
// conversion (see src/lib/analytics.ts) - "genuine" per the product brief
// in the sense that it's real, queryable data rather than a call into a
// third-party provider that isn't configured yet (there is no GA/PostHog/
// Segment key anywhere in this app). `name` is a plain string, not an
// enum, deliberately: a new event for a future add-on category should
// never need a migration just to be recorded. `category`/`surface` are
// free-text dimensions (e.g. "AIRPORT_TRANSFER" / "property_page") so the
// same table serves every current and future add-on without a schema
// change per category. No foreign keys to User/Booking/ExtraOffering -
// this table must keep recording events for a booking or offering that's
// since been deleted, and a logged-out visitor viewing a homepage promo
// has no userId at all.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  category   String?
  surface    String?
  userId     String?
  bookingId  String?
  offeringId String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId])
  @@index([bookingId])
}

// ============================================================================
// Hotel affiliate marketplace - FYStay surfaces third-party hotel inventory
// (Booking.com first, more providers later) that FYStay never books or takes
// payment for: a guest clicks through and completes the booking on the
// provider's own site. Deliberately separate from Listing/RoomType/Booking
// above, which is FYStay's own directly-managed inventory that FYStay does
// take payment for (including PropertyType.HOTEL listings, which are a
// FYStay host's own property, not a third-party affiliate hotel) - these two
// "hotel" concepts share a name and nothing else, so they get entirely
// separate tables and code paths rather than any shared/extended model.
//
// Provider identity is a plain string code on HotelProvider, not an enum
// (contrast PmsProvider above): the explicit goal here is that adding
// Expedia or HBX/Hotelbeds later is a new HotelProvider row plus a new
// adapter implementation, never a migration. No credentials live in this
// schema anywhere - every provider's API key/secret is an environment
// variable, the same convention every other integration in this app already
// follows (Cloudbeds, Twilio, Ticketmaster, Sentry, PMS encryption).
//
// Access model: matches the rest of this schema (a single shared Prisma
// connection, app-layer checks, no per-row Postgres RLS) rather than the one
// PMS exception, since there is no per-host/per-tenant data here to isolate
// - these tables are either public marketplace data (providers, cached
// hotels, aggregate search/click history) or FYStay's own commercial
// tracking data. "Cannot be exposed or modified by unauthorized users" is
// enforced the same way every other admin-only table in this schema already
// is: provider configuration and the full analytics rollup are read/written
// only from routes that check session.user.role === "ADMIN" (see every
// existing /api/admin/* route); the public search/click routes are
// rate-limited, insert-only from a guest's perspective, and never accept a
// client-supplied deep-link URL - only a (providerId, hotelId) pair we
// already stored ourselves, which is also what closes off the open-redirect
// risk on the click endpoint (see src/lib/hotelProviders/ once built).
// ============================================================================

// COMING_SOON lets a provider be seeded and configured ahead of actually
// going live (e.g. while a partner application is pending) without it
// appearing in search. INACTIVE is the safe default on creation - a new
// provider row never starts serving traffic by accident.
enum HotelProviderStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

// One row per third-party hotel supplier FYStay integrates with.
// Capabilities are booleans, not assumed uniform across providers - a
// provider added later may support deep links and clicks but not real-time
// availability or conversion postbacks, and the search/UI layer needs to
// know that per provider rather than assuming every adapter implements
// every method identically.
model HotelProvider {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Stable machine key an adapter registers itself under (e.g.
  // "booking_com", "expedia", "hotelbeds") - what code looks providers up
  // by, distinct from `name`, which is just display copy.
  code String @unique
  name String

  status HotelProviderStatus @default(INACTIVE)

  supportsSearch             Boolean @default(true)
  supportsDeepLink           Boolean @default(true)
  supportsClickTracking      Boolean @default(true)
  // Most affiliate programs don't hand back real-time booking/commission
  // data without separate reporting-API approval - false is the honest
  // default until that access is confirmed for a given provider, so the
  // admin dashboard never implies conversion tracking exists where it
  // doesn't (see AffiliateConversion's own comment).
  supportsConversionTracking Boolean @default(false)

  // Which provider to prefer once more than one is ACTIVE at once (e.g. a
  // future aggregated search across providers) - higher sorts first. Inert
  // today with only one active provider.
  priority Int @default(0)

  websiteUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotels   AffiliateHotel[]
  searches AffiliateSearch[]
  clicks   AffiliateClick[]

  @@index([status])
}

// A cached, normalized hotel record from one provider's search/details API -
// never FYStay's own inventory (contrast Listing). Every price/rating field
// here is "last seen from the provider", not a live, guaranteed value - the
// UI must treat lastFetchedAt as a staleness signal (see Phase 5's "don't
// display stale prices as guaranteed") rather than presenting these columns
// as current fact.
model AffiliateHotel {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  providerId String        @db.Uuid
  provider   HotelProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  // The provider's own identifier for this hotel - what a later search/
  // details call upserts against, and what a deep link is ultimately built
  // from.
  externalId String

  name        String
  description String?
  city        String
  country     String
  latitude    Float?
  longitude   Float?

  // Provider star class (1-5) and guest review score are deliberately
  // separate fields, not merged into one "rating" - providers score these
  // on different scales (e.g. a /10 review score vs a 1-5 star class) and
  // conflating them would misrepresent whichever one a provider doesn't
  // send.
  starRating  Float?
  guestRating Float?
  reviewCount Int?

  primaryPhotoUrl String?
  photos          String[]
  facilities      String[]

  // Cache-only pricing, not authoritative - see this model's own top
  // comment. Null until at least one search/details call has populated it.
  currency            String?
  lastKnownPriceCents Int?
  lastFetchedAt       DateTime?

  // App-generated, guaranteed-unique slug for the /hotels/[destination]/
  // [hotel-slug] URL (see Phase 6) - built from the hotel's name/city plus a
  // short disambiguator at creation time, never trusted as unique by
  // construction alone (hence the explicit unique constraint below).
  slug String @unique

  // Full normalized provider payload, for debugging a bad-looking cached
  // record without re-calling the provider - same pattern as
  // LocalPlace.rawData elsewhere in this schema.
  rawData Json?

  // Lets an admin suppress a bad/stale cached record from search without
  // deleting the row (and losing its click/conversion history).
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms  AffiliateHotelRoom[]
  clicks AffiliateClick[]

  @@unique([providerId, externalId])
  @@index([city])
  @@index([providerId])
}

// A cached per-room-type deal under one AffiliateHotel, for providers whose
// API returns room-level detail rather than just a single headline price.
// Optional by nature - a provider/hotel combination with no room-level data
// simply has zero rows here, and the UI falls back to AffiliateHotel's own
// headline price.
model AffiliateHotelRoom {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  hotelId String         @db.Uuid
  hotel   AffiliateHotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  externalRoomId String?
  name           String
  description    String?
  maxGuests      Int?

  currency   String?
  priceCents Int?
  refundable Boolean?

  lastFetchedAt DateTime?
  rawData       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
}

// One row per hotel search performed against a provider - powers the
// admin dashboard's "total searches" and search-to-click funnel. providerId
// is nullable on purpose: a single search performed against more than one
// provider at once (a future aggregated search, Phase 10) still logs as one
// row per provider call today, but keeping this nullable means that
// shape can change later without another migration - a null providerId
// would mean "this search wasn't scoped to one provider", not used yet.
model AffiliateSearch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  providerId String?        @db.Uuid
  provider   HotelProvider? @relation(fields: [providerId], references: [id], onDelete: Restrict)

  destination    String
  destinationLat Float?
  destinationLng Float?
  checkIn        DateTime
  checkOut       DateTime
  adults         Int      @default(1)
  children       Int      @default(0)
  rooms          Int      @default(1)

  // Null means the provider call errored/timed out rather than genuinely
  // returning zero results - the admin dashboard and Phase 5's "provider
  // unavailable" state both need to tell those apart.
  resultCount Int?

  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?

  createdAt DateTime @default(now())

  clicks AffiliateClick[]

  @@index([createdAt])
  @@index([providerId])
  @@index([userId])
}

// One row per "View Deal" / "Book Now" click - the record Phase 7 describes,
// and the join point between a FYStay-side search/impression and whatever a
// provider is later willing to report back about it.
model AffiliateClick {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  providerId String        @db.Uuid
  provider   HotelProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  hotelId String         @db.Uuid
  hotel   AffiliateHotel @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  // Nullable: a click can happen straight off a destination landing page's
  // featured-hotel slot, not only from a logged search.
  searchId String?          @db.Uuid
  search   AffiliateSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)

  // The tracking/sub-ID FYStay generates and passes to the provider in the
  // deep link (Booking.com's aid/sub-id mechanism, or the equivalent on a
  // future provider) - what a later conversion postback/report is matched
  // back to this exact click by. Defaulted so a click can be recorded and a
  // deep link built in the same request without a round trip.
  subId String @unique @default(cuid())

  destination String?
  checkIn     DateTime?
  checkOut    DateTime?

  // The exact URL the guest was sent to - a full audit trail of what FYStay
  // actually redirected to, built entirely server-side from providerId +
  // hotelId + subId (see this file's own top comment on the open-redirect
  // protection this gives).
  deepLinkUrl String

  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String?
  ipAddress    String?
  userAgent    String?
  // Which FYStay page the click came from (e.g. "/hotels/blackpool/...") -
  // for the admin dashboard's revenue-by-destination view without needing a
  // separate destination column duplicated from the referring page.
  referrerPath String?

  createdAt DateTime @default(now())

  conversion AffiliateConversion?

  @@index([providerId, createdAt])
  @@index([hotelId])
  @@index([searchId])
  @@index([userId])
}

// A confirmed (or pending/cancelled) booking outcome reported back by a
// provider against one specific click - only ever created from a real
// provider report or postback, never inferred or guessed client-side. This
// is what makes "Do not claim a booking or commission has happened unless
// the provider confirms it" true structurally: there is no path to a
// nonzero commissionCents that doesn't originate from provider data landing
// in this table.
enum AffiliateConversionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model AffiliateConversion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  clickId String         @unique @db.Uuid
  click   AffiliateClick @relation(fields: [clickId], references: [id], onDelete: Cascade)

  status AffiliateConversionStatus @default(PENDING)

  externalBookingReference String?
  bookingValueCents        Int?
  currency                 String?
  // The admin dashboard's "estimated" vs "confirmed" commission split
  // (Phase 8) is this one field's own state, not two separate columns:
  // commissionCents is always FYStay's best-known figure, and
  // commissionConfirmed says whether that figure came from the provider's
  // own finalized report (true) or an estimate calculated from the
  // provider's published commission rate before final confirmation (false).
  commissionCents          Int?
  commissionConfirmed      Boolean @default(false)

  reportedAt DateTime?
  rawData    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// A small DB-backed cache in front of the two provider calls worth caching
// (searchHotels, getAvailability - see src/lib/hotelProviders/cache.ts for
// exactly which and why). Not an in-memory cache: same reasoning as
// RateLimitHit above - FYStay runs as short-lived Vercel serverless
// functions, so an in-process cache wouldn't survive a cold start or agree
// across concurrent instances. providerCode is a plain string, not a
// relation to HotelProvider, since the cache key is already provider-scoped
// and nothing here needs a join back to that table.
model HotelProviderCacheEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cacheKey     String   @unique
  providerCode String
  payload      Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

// --- Paid featuring ("Spotlight stays") --------------------------------------
//
// A host pays FYStay (a platform charge, never Connect - this is FYStay's own
// advertising product, like a Trip Extra) to feature one of their listings in
// the homepage's Spotlight row for a fixed number of days. See
// src/lib/listingPromotions.ts for the plans, eligibility and capacity rules.

enum ListingPromotionStatus {
  // A Checkout Session exists but hasn't been paid. Holds no Spotlight spot.
  PENDING_PAYMENT
  // Paid: startsAt/endsAt are set. Live while startsAt <= now < endsAt,
  // scheduled before that, finished after - derived from the dates, so
  // nothing has to run to expire a placement.
  PAID
  // The checkout was abandoned (its session expired) - never charged.
  CANCELLED
}

model ListingPromotion {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // The host who paid - kept separately from listing.hostId so the record
  // still says who bought it if the listing ever changed hands.
  hostId    String
  host      User    @relation(fields: [hostId], references: [id], onDelete: Cascade)

  // Snapshotted from the plan at purchase time (see PROMOTION_PLANS), so a
  // later price change never rewrites what an earlier host paid.
  plan       String
  days       Int
  priceCents Int

  status       ListingPromotionStatus @default(PENDING_PAYMENT)
  // Both set when payment lands: starts then, or straight after this
  // listing's latest paid placement ends (buying again extends, it never
  // overlaps).
  startsAt     DateTime?
  endsAt       DateTime?
  // Set when an admin ends a placement early (endsAt is moved to that
  // moment). Any refund is made separately in Stripe.
  endedEarlyAt DateTime?

  stripeSessionId       String?   @unique
  stripePaymentIntentId String?
  paidAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endsAt])
  @@index([listingId])
  @@index([hostId])
}
