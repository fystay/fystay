    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "otpauth": "^9.5.2",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
