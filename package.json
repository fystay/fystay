{
  "name": "fystay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-coordinates": "tsx prisma/backfill-coordinates.ts",
    "db:seed-editorial": "tsx prisma/seed-editorial.ts",
    "db:hotel-provider": "tsx prisma/hotel-provider.ts",
    "db:manifest": "tsx scripts/db/update-migration-manifest.ts",
    "db:check-migrations": "tsx scripts/db/check-migration-manifest.ts",
    "admin:grant": "tsx scripts/admin/grant-admin.ts",
    "listing:import-lodge": "tsx --conditions=react-server scripts/listings/import-lodge-on-the-lake.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.74.0",
    "@supabase/supabase-js": "^2.112.4",
